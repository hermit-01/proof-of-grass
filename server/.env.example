# Copy to server/.env for local runs (server/.env is git-ignored). On Render, set these in the dashboard.
# "memory" starts a throwaway in-memory MongoDB. Use your Atlas connection string to keep data.
MONGODB_URI=memory
# At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
NODE_ENV=development
PORT=3000
